{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\mssqllocaldb;Database=CargoCaptainDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "ApplicationSettings": {
    "ApplicationName": "CargoCaptain",
    "Environment": "Development",
    "SupportedRoles": [ "Admin", "Shipper", "Consignee", "CustomsAgent", "TerminalOperator" ]
  },
  "FileUploadSettings": {
    "MaxFileSizeBytes": 10485760,
    "AllowedExtensions": [ ".pdf", ".jpg", ".png", ".doc", ".docx", ".xml" ],
    "UploadDirectory": "wwwroot/uploads"
  },
  "InvoiceSettings": {
    "DefaultCurrency": "USD",
    "VatRatePercent": 15.0,
    "PaymentTermsDays": 30
  },
  "DemurrageSettings": {
    "FreeDaysLimit": 3,
    "DailyRateUsd": 50.00
  }
}
