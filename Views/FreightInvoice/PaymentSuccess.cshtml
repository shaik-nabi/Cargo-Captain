@model CargoCaptain.Models.FreightInvoice

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Payment Successful";
}

<div class="row justify-content-center my-5">
    <div class="col-lg-6 col-md-8 text-center">
        <div class="bg-white p-5 border rounded-3 shadow-sm">
            <!-- Success Icon -->
            <div class="text-success mb-4">
                <i class="fas fa-check-circle fa-5x"></i>
            </div>
            
            <h2 class="fw-bold text-dark mb-2">Payment Successful!</h2>
            <p class="text-muted mb-4">Your transaction was processed successfully. Thank you for shipping with CargoCaptain.</p>
            
            <!-- Receipt breakdown -->
            <div class="border rounded bg-light p-4 text-start mb-4 fs-6">
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Invoice Number</span>
                    <strong class="text-dark">@Model.invoiceNumber</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Booking Reference</span>
                    <strong class="text-dark">@Model.ShipmentBooking?.bookingNumber</strong>
                </div>
                <div class="d-flex justify-content-between mb-2">
                    <span class="text-muted">Payment Date</span>
                    <strong class="text-dark">@Model.paymentDate?.ToString("yyyy-MM-dd HH:mm UTC")</strong>
                </div>
                <hr />
                <div class="d-flex justify-content-between mb-0 fs-5 text-primary fw-bold">
                    <span>Total Paid</span>
                    <span>$@(User.IsInRole("Consignee") ? Model.demurrageAmount.ToString("N2") : (Model.freightCharges + Model.surchargeAmount).ToString("N2")) USD</span>
                </div>
            </div>

            <!-- Action buttons -->
            <div class="d-flex gap-3 justify-content-center">
                <a href="/FreightInvoice/Details?id=@Model.invoiceId" class="btn btn-outline-secondary px-4">
                    <i class="fas fa-print me-1"></i> Print Receipt
                </a>
                <a href="/FreightInvoice/MyInvoices" class="btn btn-primary-custom px-4">
                    My Invoices
                </a>
            </div>
        </div>
    </div>
</div>
