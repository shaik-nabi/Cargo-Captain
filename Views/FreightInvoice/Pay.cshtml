@model CargoCaptain.ViewModels.PaymentViewModel

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Submit Payment";
}

<!-- Breadcrumbs Header -->
<div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Console</a></li>
                <li class="breadcrumb-item"><a href="/FreightInvoice/MyInvoices" class="text-decoration-none">My Invoices</a></li>
                <li class="breadcrumb-item active" aria-current="page">Pay Invoice</li>
            </ol>
        </nav>
        <h2 class="h3 mb-0 fw-bold text-dark">Secure Payment Gateway</h2>
    </div>
</div>

<div class="row justify-content-center">
    <div class="col-lg-6 col-md-8">
        <div class="bg-white p-4 p-md-5 border rounded-3 shadow-sm text-start">
            <h5 class="fw-bold text-dark border-bottom pb-2 mb-4">
                <i class="fas fa-shield-alt text-primary me-2"></i>
                @if (Model.PaymentType == "Demurrage")
                {
                    <span>Pay Demurrage Charges</span>
                }
                else
                {
                    <span>Pay Freight Invoice</span>
                }
            </h5>

            <!-- Total Amount Card -->
            <div class="bg-light p-3 rounded mb-4 text-center border">
                <span class="text-muted small d-block">Amount Due (@(Model.PaymentType == "Demurrage" ? "Demurrage Portion" : "Freight & Surcharges"))</span>
                <h3 class="fw-bold text-primary mb-0">$@Model.TotalAmount.ToString("N2") <span class="small text-muted fs-6">USD</span></h3>
            </div>

            <form method="post" asp-controller="FreightInvoice" asp-action="Pay">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="InvoiceId" />
                <input type="hidden" asp-for="PaymentType" />

                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <!-- Cardholder Name -->
                <div class="mb-3">
                    <label asp-for="CardHolderName" class="form-label small fw-semibold text-dark"></label>
                    <input asp-for="CardHolderName" class="form-control form-control-sm" placeholder="e.g. John Doe" required />
                    <span asp-validation-for="CardHolderName" class="text-danger small"></span>
                </div>

                <!-- Card Number -->
                <div class="mb-3">
                    <label asp-for="CardNumber" class="form-label small fw-semibold text-dark"></label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text bg-light text-muted"><i class="far fa-credit-card"></i></span>
                        <input asp-for="CardNumber" class="form-control" placeholder="16-digit Card Number" maxlength="16" required />
                    </div>
                    <span asp-validation-for="CardNumber" class="text-danger small"></span>
                </div>

                <!-- Expiry and CVV -->
                <div class="row g-2 mb-4">
                    <div class="col-6">
                        <label asp-for="ExpirationDate" class="form-label small fw-semibold text-dark"></label>
                        <input asp-for="ExpirationDate" class="form-control form-control-sm" placeholder="MM/YY" maxlength="5" required />
                        <span asp-validation-for="ExpirationDate" class="text-danger small"></span>
                    </div>
                    <div class="col-6">
                        <label asp-for="CVV" class="form-label small fw-semibold text-dark"></label>
                        <input asp-for="CVV" type="password" class="form-control form-control-sm" placeholder="CVV" maxlength="4" required />
                        <span asp-validation-for="CVV" class="text-danger small"></span>
                    </div>
                </div>

                <!-- Security Disclaimer Alert -->
                <div class="alert alert-info py-2 px-3 small border mb-4 text-muted">
                    <i class="fas fa-lock me-1"></i>
                    <span><strong>Security Note:</strong> Credit card details are validated but never stored in our systems. Only transaction status is updated.</span>
                </div>

                <div class="d-grid">
                    <button type="submit" class="btn btn-primary w-100 fw-semibold">Authorize & Pay</button>
                </div>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
