@model CargoCaptain.Models.ShipmentBooking

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Bill of Lading - @Model.bookingNumber</title>
    
    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <style>
        body {
            background-color: #ffffff;
            color: #000000;
            font-family: Arial, sans-serif;
            font-size: 12px;
            line-height: 1.4;
            padding: 20px;
        }
        .bol-header {
            border-bottom: 2px solid #000;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }
        .bol-title {
            font-size: 24px;
            font-weight: bold;
            text-transform: uppercase;
        }
        .bol-section {
            border: 1px solid #000;
            margin-bottom: 15px;
        }
        .bol-section-header {
            background-color: #f0f0f0;
            border-bottom: 1px solid #000;
            font-weight: bold;
            padding: 5px;
            text-transform: uppercase;
        }
        .bol-section-body {
            padding: 10px;
        }
        .print-btn-bar {
            background-color: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            padding: 10px 20px;
            margin: -20px -20px 20px -20px;
        }
        @@media print {
            .print-btn-bar {
                display: none;
            }
            body {
                padding: 0;
            }
        }
    </style>
</head>
<body>

    <!-- Print Control Bar -->
    <div class="print-btn-bar d-flex justify-content-between align-items-center">
        <span class="fw-bold text-dark">CargoCaptain Ocean Bill of Lading printable View</span>
        <button onclick="window.print();" class="btn btn-primary btn-sm px-3"><i class="fas fa-print"></i> Print Document</button>
    </div>

    <div class="container px-0">
        <!-- Document Header -->
        <div class="bol-header d-flex justify-content-between align-items-end">
            <div>
                <h1 class="bol-title mb-0">Bill of Lading</h1>
                <div class="text-muted">International Maritime Carriage of Goods</div>
            </div>
            <div class="text-end">
                <div><strong>B/L Number:</strong> @Model.bookingNumber</div>
                <div><strong>Date of Issue:</strong> @DateTime.UtcNow.ToString("yyyy-MM-dd")</div>
            </div>
        </div>

        <div class="row g-3">
            <!-- Shipper details -->
            <div class="col-6">
                <div class="bol-section h-100">
                    <div class="bol-section-header">Shipper (Consignor)</div>
                    <div class="bol-section-body">
                        <strong>@Model.shipperName</strong>
                        <div class="text-muted mt-1">CargoCaptain Verified Shipping Account</div>
                    </div>
                </div>
            </div>
            <!-- Consignee details -->
            <div class="col-6">
                <div class="bol-section h-100">
                    <div class="bol-section-header">Consignee (To the order of)</div>
                    <div class="bol-section-body">
                        <strong>@Model.consigneeName</strong>
                        <div class="text-muted mt-1">Consignee Delivery Account</div>
                    </div>
                </div>
            </div>

            <!-- Routing parameters -->
            <div class="col-12">
                <div class="bol-section">
                    <div class="bol-section-header">Routing and Carriage Parameters</div>
                    <div class="bol-section-body">
                        <div class="row text-start">
                            <div class="col-4">
                                <strong>Port of Loading (POL)</strong>
                                <div>@Model.originPort</div>
                            </div>
                            <div class="col-4">
                                <strong>Port of Discharge (POD)</strong>
                                <div>@Model.destinationPort</div>
                            </div>
                            <div class="col-4">
                                <strong>Vessel / Voyage</strong>
                                <div>CARGO CAPTAIN FLEET / V-@DateTime.UtcNow.ToString("yyMMdd")</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Containers manifest list -->
            <div class="col-12">
                <div class="bol-section">
                    <div class="bol-section-header">Particulars Furnished by Shipper (Cargo Manifest)</div>
                    <table class="table table-bordered mb-0" style="font-size: 11px;">
                        <thead class="table-light">
                            <tr>
                                <th>Container Number</th>
                                <th>Seal Number</th>
                                <th>Container Type</th>
                                <th>Gross Weight</th>
                            </tr>
                        </thead>
                        <tbody>
                            @if (Model.Containers != null && Model.Containers.Any())
                            {
                                foreach (var c in Model.Containers)
                                {
                                    <tr>
                                        <td>@c.containerNumber</td>
                                        <td>@c.sealNumber</td>
                                        <td>@c.containerType</td>
                                        <td>@((Model.cargoWeight / Model.Containers.Count).ToString("N2")) Tons (Est.)</td>
                                    </tr>
                                }
                            }
                            else
                            {
                                <tr>
                                    <td colspan="4" class="text-center text-muted">No allocated containers mapped to manifest.</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            </div>

            <!-- Description -->
            <div class="col-12">
                <div class="bol-section">
                    <div class="bol-section-header">Description of Goods</div>
                    <div class="bol-section-body">
                        <p class="mb-0"><strong>Commodity details:</strong> @Model.cargoDescription</p>
                        <div class="text-muted small mt-2">Weight declared by shipper: @Model.cargoWeight.ToString("N2") Metric Tons</div>
                    </div>
                </div>
            </div>

            <!-- Conditions & Signatures -->
            <div class="col-12 mt-4">
                <div class="row">
                    <div class="col-6">
                        <div class="border p-3 small text-muted h-100" style="font-size: 9px; line-height: 1.2;">
                            RECEIVED by the Carrier in apparent good order and condition unless otherwise indicated herein, the Goods to be carried subject to all the terms and conditions printed on the back hereof.
                        </div>
                    </div>
                    <div class="col-6">
                        <div class="border p-3 text-center d-flex flex-column justify-content-between h-100" style="min-height: 100px;">
                            <div class="small fw-bold border-bottom pb-2">For Port Terminal Carrier / Port Authorities</div>
                            <div class="text-muted small italic mt-4">Authorized Signature Placeholders</div>
                        </div>
                    </div>
                </div>
            </div>

        </div>
    </div>

</body>
</html>
