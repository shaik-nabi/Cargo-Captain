@model CargoCaptain.ViewModels.TrackingDetailsViewModel

@{
    ViewData["Title"] = "Cargo Tracking";
    var hasModel = Model != null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CargoCaptain</title>
    
    <!-- Google Font & Icons Cdn -->
    <link href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.2/css/all.min.css" rel="stylesheet" />

    <style>
        body {
            font-family: 'Outfit', sans-serif;
            background-color: #f8fafc;
            color: #0f172a;
        }
        .tracking-header {
            background: linear-gradient(135deg, #0f172a 0%, #1e293b 100%);
            color: #ffffff;
            padding: 80px 0;
            border-bottom: 1px solid #334155;
        }
        .search-box-card {
            border: none;
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0,0,0,0.08);
            margin-top: -50px;
            z-index: 10;
        }
        .timeline-item {
            border-left: 2px solid #e2e8f0;
            padding-left: 25px;
            position: relative;
        }
        .timeline-marker {
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background-color: #2563eb;
            position: absolute;
            left: -9px;
            top: 2px;
            border: 3px solid #ffffff;
            box-shadow: 0 0 0 3px rgba(37,99,235,0.2);
        }
        .progress-bar-custom {
            height: 8px;
            border-radius: 4px;
        }
    </style>
</head>
<body>

    <!-- Header Section -->
    <header class="tracking-header text-center">
        <div class="container">
            <h1 class="fw-bold display-5 mb-2"><i class="fas fa-route text-primary me-2"></i>Cargo Tracking</h1>
            <p class="lead text-muted mb-0">Track your ocean carrier logistics and customs milestones in real-time.</p>
        </div>
    </header>

    <div class="container mb-5">
        <div class="row justify-content-center">
            <div class="col-lg-8">
                <!-- Search Box Card -->
                <div class="card search-box-card bg-white p-4 mb-4">
                    <form method="get" asp-controller="Tracking" asp-action="Search">
                        <div class="row g-2">
                            <div class="col-sm-9">
                                <div class="input-group">
                                    <span class="input-group-text bg-light border-end-0 text-muted"><i class="fas fa-search"></i></span>
                                    <input name="bookingNumber" type="text" class="form-control border-start-0 bg-light" placeholder="Enter Booking Number (e.g. BKG-20260719-ABCD)" value="@ViewBag.SearchQuery" required />
                                </div>
                            </div>
                            <div class="col-sm-3">
                                <button type="submit" class="btn btn-primary w-100 fw-semibold px-4">Track Cargo</button>
                            </div>
                        </div>
                    </form>
                    
                    @if (ViewBag.ErrorMessage != null)
                    {
                        <div class="alert alert-warning alert-dismissible fade show mt-3 mb-0 text-start" role="alert">
                            <i class="fas fa-exclamation-triangle me-2"></i> @ViewBag.ErrorMessage
                            <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
                        </div>
                    }
                </div>

                <!-- Results Section -->
                @if (Model != null)
                {
                    var tracking = Model;
                    <!-- Progress Card -->
                    <div class="card border-0 shadow-sm p-4 mb-4 rounded-3 text-start">
                        <div class="d-flex justify-content-between align-items-center mb-3">
                            <div>
                                <span class="text-muted small d-block">Booking Reference</span>
                                <h3 class="fw-bold text-dark mb-0">@tracking.BookingNumber</h3>
                            </div>
                            <span class="badge bg-primary bg-opacity-10 text-primary p-2 fs-6">@tracking.CurrentStatus</span>
                        </div>

                        <!-- Progress Bar -->
                        <div class="mb-2 mt-4">
                            <div class="d-flex justify-content-between small text-muted mb-1">
                                <span>Milestone Completion Progress</span>
                                <span class="fw-bold text-dark">@tracking.ProgressPercentage%</span>
                            </div>
                            <div class="progress progress-bar-custom bg-light">
                                <div class="progress-bar bg-primary" role="progressbar" style="width: @tracking.ProgressPercentage%" aria-valuenow="@tracking.ProgressPercentage" aria-valuemin="0" aria-valuemax="100"></div>
                            </div>
                        </div>

                        <div class="small text-muted mt-3">
                            <i class="far fa-clock me-1"></i> Latest Status Update: <strong>@(tracking.LatestUpdate?.ToString("yyyy-MM-dd HH:mm UTC") ?? "N/A")</strong>
                        </div>
                    </div>

                    <!-- Details Card -->
                    <div class="card border-0 shadow-sm p-4 mb-4 rounded-3 text-start">
                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="fas fa-info-circle text-primary me-2"></i>Shipment Particulars</h5>
                        <div class="row g-3 small">
                            <div class="col-sm-6">
                                <span class="text-muted">Port of Loading (Origin)</span>
                                <div class="fw-bold text-dark fs-6 mt-1">@tracking.OriginPort</div>
                            </div>
                            <div class="col-sm-6">
                                <span class="text-muted">Port of Discharge (Destination)</span>
                                <div class="fw-bold text-dark fs-6 mt-1">@tracking.DestinationPort</div>
                            </div>
                            <div class="col-sm-12">
                                <span class="text-muted">Goods Description</span>
                                <p class="text-muted mb-0 mt-1">@tracking.CargoDescription</p>
                            </div>
                        </div>
                    </div>

                    <!-- Timeline Card -->
                    <div class="card border-0 shadow-sm p-4 mb-4 rounded-3 text-start">
                        <h5 class="fw-bold text-dark border-bottom pb-2 mb-4"><i class="fas fa-history text-primary me-2"></i>Combined shipment History</h5>
                        
                        @if (tracking.TimelineItems != null && tracking.TimelineItems.Any())
                        {
                            <div class="ps-2">
                                @foreach (var item in tracking.TimelineItems)
                                {
                                    <div class="timeline-item pb-4 position-relative">
                                        <div class="timeline-marker"></div>
                                        <div class="d-flex justify-content-between align-items-center mb-1">
                                            <strong class="text-dark">@item.EventName</strong>
                                            <span class="small text-muted">@item.Timestamp.ToString("yyyy-MM-dd HH:mm")</span>
                                        </div>
                                        <div class="small text-muted mb-1"><i class="fas fa-map-marker-alt me-1 text-opacity-50"></i>@item.Location</div>
                                        @if (!string.IsNullOrWhiteSpace(item.Remarks))
                                        {
                                            <div class="text-muted small mt-1">@item.Remarks</div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-5 text-muted">
                                <i class="fas fa-route fa-3x mb-2 text-opacity-25 text-primary"></i>
                                <div>No tracking records found.</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>

    <!-- Bootstrap Bundle JS -->
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
