@model CargoCaptain.ViewModels.ContainerAllocationViewModel
@using CargoCaptain.Enums

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Container Allocation";
}

<!-- Breadcrumbs Header -->
<div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Console</a></li>
                <li class="breadcrumb-item"><a href="/Container/MasterBookings" class="text-decoration-none">Master Bookings</a></li>
                <li class="breadcrumb-item active" aria-current="page">Allocate</li>
            </ol>
        </nav>
        <h2 class="h3 mb-0 fw-bold text-dark">Allocate Containers to: @Model.bookingNumber</h2>
    </div>
</div>

<!-- TempData Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<div class="row g-4">
    <!-- Left Column: Add Container Form -->
    <div class="col-lg-5">
        <div class="bg-white p-4 border rounded-3 shadow-sm mb-4">
            <h5 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="fas fa-plus-circle text-primary me-2"></i>Allocate Container</h5>
            
            <form method="post" asp-controller="Container" asp-action="Allocate">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="bookingId" />
                
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="containerNumber" class="form-label small fw-bold"></label>
                    <input asp-for="containerNumber" class="form-control form-control-sm" placeholder="e.g. MSCU1234567" style="text-transform: uppercase;" required />
                    <span asp-validation-for="containerNumber" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="sealNumber" class="form-label small fw-bold"></label>
                    <input asp-for="sealNumber" class="form-control form-control-sm" placeholder="e.g. SEAL123456" required />
                    <span asp-validation-for="sealNumber" class="text-danger small"></span>
                </div>

                <div class="row g-2 mb-4">
                    <div class="col-sm-6">
                        <label asp-for="containerType" class="form-label small fw-bold"></label>
                        <select asp-for="containerType" class="form-select form-select-sm" required>
                            <option value="@ContainerType.DRY">DRY</option>
                            <option value="@ContainerType.REEFER">REEFER</option>
                            <option value="@ContainerType.FLAT_RACK">FLAT RACK</option>
                            <option value="@ContainerType.OPEN_TOP">OPEN TOP</option>
                        </select>
                        <span asp-validation-for="containerType" class="text-danger small"></span>
                    </div>
                    <div class="col-sm-6">
                        <label asp-for="containerStatus" class="form-label small fw-bold"></label>
                        <select asp-for="containerStatus" class="form-select form-select-sm" required>
                            <option value="@ContainerStatus.EMPTY">EMPTY</option>
                            <option value="@ContainerStatus.LOADED">LOADED</option>
                            <option value="@ContainerStatus.IN_TRANSIT">IN TRANSIT</option>
                            <option value="@ContainerStatus.DISCHARGED">DISCHARGED</option>
                        </select>
                        <span asp-validation-for="containerStatus" class="text-danger small"></span>
                    </div>
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <a href="/Container/MasterBookings" class="btn btn-outline-secondary btn-sm">Cancel</a>
                    <button type="submit" class="btn btn-primary-custom btn-sm">Allocate Container</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Right Column: Current Containers Table -->
    <div class="col-lg-7">
        <div class="bg-white p-4 border rounded-3 shadow-sm h-100">
            <h5 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="fas fa-boxes text-primary me-2"></i>Allocated Containers</h5>
            
            @if (Model.AllocatedContainers != null && Model.AllocatedContainers.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0 text-start" style="font-size: 0.88rem;">
                        <thead class="table-light">
                            <tr>
                                <th>Container Number</th>
                                <th>Seal Number</th>
                                <th>Type</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.AllocatedContainers)
                            {
                                <tr>
                                    <td class="fw-bold text-dark">@c.containerNumber</td>
                                    <td>@c.sealNumber</td>
                                    <td>@c.containerType</td>
                                    <td>
                                        <span class="badge bg-light text-dark border p-2">@c.containerStatus</span>
                                    </td>
                                    <td class="text-end">
                                        <!-- Container Removal Form -->
                                        <form method="post" asp-controller="Container" asp-action="Remove" asp-route-id="@c.containerId" asp-route-bookingId="@Model.bookingId" onsubmit="return confirm('Are you sure you want to remove this container allocation?');">
                                            @Html.AntiForgeryToken()
                                            <button type="submit" class="btn btn-sm btn-outline-danger" title="Remove Allocation">
                                                <i class="far fa-trash-alt"></i>
                                            </button>
                                        </form>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-truck-loading fa-3x mb-3 text-opacity-25 text-primary"></i>
                    <h5 class="fw-bold text-dark">No allocated containers</h5>
                    <p class="small text-muted mb-0">Use the form to assign containers to this booking.</p>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
