@model CargoCaptain.ViewModels.ForwarderDashboardViewModel

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Forwarder Dashboard";
}

<!-- Breadcrumbs Header -->
<div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Console</a></li>
                <li class="breadcrumb-item active" aria-current="page">Forwarder Dashboard</li>
            </ol>
        </nav>
        <h2 class="h3 mb-0 fw-bold text-dark">Freight Forwarder Console</h2>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-4 mb-4">
    <!-- Card 1: Total Bookings -->
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card">
            <div>
                <span class="metric-title">Total Bookings</span>
                <h3 class="metric-value mb-0 mt-1">@Model.TotalBookings</h3>
            </div>
            <div class="metric-icon-box bg-primary bg-opacity-10 text-primary">
                <i class="fas fa-file-contract fa-lg"></i>
            </div>
        </div>
    </div>
    <!-- Card 2: Pending Allocations -->
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card">
            <div>
                <span class="metric-title">Pending Allocations</span>
                <h3 class="metric-value mb-0 mt-1">@Model.PendingAllocationsCount</h3>
            </div>
            <div class="metric-icon-box bg-warning bg-opacity-10 text-warning">
                <i class="fas fa-boxes fa-lg"></i>
            </div>
        </div>
    </div>
    <!-- Card 3: Completed Allocations -->
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card">
            <div>
                <span class="metric-title">Completed Allocations</span>
                <h3 class="metric-value mb-0 mt-1">@Model.CompletedAllocationsCount</h3>
            </div>
            <div class="metric-icon-box bg-success bg-opacity-10 text-success">
                <i class="fas fa-check-double fa-lg"></i>
            </div>
        </div>
    </div>
    <!-- Card 4: Allocated Containers -->
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card">
            <div>
                <span class="metric-title">Active Containers</span>
                <h3 class="metric-value mb-0 mt-1">@Model.TotalContainers</h3>
            </div>
            <div class="metric-icon-box bg-info bg-opacity-10 text-info">
                <i class="fas fa-cubes fa-lg"></i>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Recent Bookings Table -->
    <div class="col-lg-6">
        <div class="premium-table-card shadow-sm h-100">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0"><i class="fas fa-list text-primary me-2"></i>Recent Shipment Bookings</h5>
                <a href="/Container/MasterBookings" class="btn btn-manage btn-sm">Master File</a>
            </div>
            
            @if (Model.RecentBookings != null && Model.RecentBookings.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
                        <thead class="table-light">
                            <tr>
                                <th>Booking Number</th>
                                <th>Route</th>
                                <th>Allocation</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var b in Model.RecentBookings)
                            {
                                <tr>
                                    <td class="fw-bold text-primary">
                                        @b.bookingNumber
                                        <div class="text-muted small fw-normal mt-1">Cargo: <strong>@b.cargoDescription</strong></div>
                                    </td>
                                    <td style="font-size: 0.78rem;">
                                        <div><strong>From:</strong> @b.originPort</div>
                                        <div><strong>To:</strong> @b.destinationPort</div>
                                    </td>
                                    <td>
                                        @if (b.Containers.Any())
                                        {
                                            <span class="badge bg-success bg-opacity-10 text-success p-2">@b.Containers.Count Containers</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning p-2">PENDING</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-folder-open fa-2x mb-2 text-opacity-50"></i>
                    <div>No Bookings Found</div>
                </div>
            }
        </div>
    </div>

    <!-- Recent Allocations Table -->
    <div class="col-lg-6">
        <div class="premium-table-card shadow-sm h-100">
            <h5 class="fw-bold text-dark mb-3"><i class="fas fa-cubes text-primary me-2"></i>Recent Allocations</h5>
            
            @if (Model.RecentAllocations != null && Model.RecentAllocations.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.88rem;">
                        <thead class="table-light">
                            <tr>
                                <th>Container No</th>
                                <th>Booking Number</th>
                                <th>Type</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var c in Model.RecentAllocations)
                            {
                                <tr>
                                    <td class="fw-bold text-dark">@c.containerNumber</td>
                                    <td class="text-primary">@c.ShipmentBooking?.bookingNumber</td>
                                    <td>@c.containerType</td>
                                    <td>
                                        <span class="badge bg-light text-dark border p-2">@c.containerStatus</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-truck-loading fa-2x mb-2 text-opacity-50"></i>
                    <div>No Container Allocations Registered</div>
                </div>
            }
        </div>
    </div>
</div>
