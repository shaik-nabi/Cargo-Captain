@model CargoCaptain.Models.ShipmentBooking

@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Vessel Manifest - @Model.bookingNumber</title>
    
    <!-- Bootstrap 5 CSS CDN -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.2/dist/css/bootstrap.min.css" rel="stylesheet">
    
    <style>
        body {
            background-color: #ffffff;
            color: #000000;
            font-family: Arial, sans-serif;
            font-size: 12px;
            line-height: 1.4;
            padding: 20px;
        }
        .manifest-header {
            border-bottom: 2px solid #000;
            padding-bottom: 10px;
            margin-bottom: 20px;
        }
        .manifest-title {
            font-size: 24px;
            font-weight: bold;
            text-transform: uppercase;
        }
        .manifest-section {
            border: 1px solid #000;
            margin-bottom: 15px;
        }
        .manifest-section-header {
            background-color: #f0f0f0;
            border-bottom: 1px solid #000;
            font-weight: bold;
            padding: 5px;
            text-transform: uppercase;
        }
        .manifest-section-body {
            padding: 10px;
        }
        .print-btn-bar {
            background-color: #f8fafc;
            border-bottom: 1px solid #e2e8f0;
            padding: 10px 20px;
            margin: -20px -20px 20px -20px;
        }
        @@media print {
            .print-btn-bar {
                display: none;
            }
            body {
                padding: 0;
            }
        }
    </style>
</head>
<body>

    <!-- Print Control Bar -->
    <div class="print-btn-bar d-flex justify-content-between align-items-center">
        <span class="fw-bold text-dark">CargoCaptain Ocean Carrier Vessel Manifest printable View</span>
        <button onclick="window.print();" class="btn btn-primary btn-sm px-3"><i class="fas fa-print"></i> Print Manifest</button>
    </div>

    <div class="container px-0">
        <!-- Document Header -->
        <div class="manifest-header d-flex justify-content-between align-items-end">
            <div>
                <h1 class="manifest-title mb-0">Vessel Cargo Manifest</h1>
                <div class="text-muted">CargoCaptain Maritime Booking Manifest</div>
            </div>
            <div class="text-end">
                <div><strong>Booking Reference:</strong> @Model.bookingNumber</div>
                <div><strong>Issue Date:</strong> @DateTime.UtcNow.ToString("yyyy-MM-dd")</div>
            </div>
        </div>

        <div class="row g-3 mb-4">
            <!-- Port / Routing Details -->
            <div class="col-12">
                <div class="manifest-section">
                    <div class="manifest-section-header">Voyage & Routing parameters</div>
                    <div class="manifest-section-body">
                        <div class="row text-start">
                            <div class="col-3">
                                <strong>Shipper</strong>
                                <div>@Model.shipperName</div>
                            </div>
                            <div class="col-3">
                                <strong>Consignee</strong>
                                <div>@Model.consigneeName</div>
                            </div>
                            <div class="col-3">
                                <strong>Port of Loading</strong>
                                <div>@Model.originPort</div>
                            </div>
                            <div class="col-3">
                                <strong>Port of Discharge</strong>
                                <div>@Model.destinationPort</div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Allocated Containers manifest list -->
            <div class="col-12">
                <div class="manifest-section">
                    <div class="manifest-section-header">Particulars of Cargo Containers</div>
                    
                    @if (Model.Containers != null && Model.Containers.Any())
                    {
                        <table class="table table-bordered mb-0" style="font-size: 11px;">
                            <thead class="table-light">
                                <tr>
                                    <th>Container Number</th>
                                    <th>Seal Number</th>
                                    <th>Container Type</th>
                                    <th>Staging Status</th>
                                    <th>Weight declared</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var c in Model.Containers)
                                {
                                    <tr>
                                        <td class="fw-bold">@c.containerNumber</td>
                                        <td>@c.sealNumber</td>
                                        <td>@c.containerType</td>
                                        <td>@c.containerStatus</td>
                                        <td>@((Model.cargoWeight / Model.Containers.Count).ToString("N2")) Tons (Est.)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    }
                    else
                    {
                        <div class="text-center py-5 text-muted">
                            <i class="fas fa-boxes fa-2x mb-2 text-opacity-50"></i>
                            <div>No containers allocated.</div>
                        </div>
                    }
                </div>
            </div>

            <!-- Description -->
            <div class="col-12">
                <div class="manifest-section">
                    <div class="manifest-section-header">Goods Description Notes</div>
                    <div class="manifest-section-body">
                        <p class="mb-0">@Model.cargoDescription</p>
                        <div class="text-muted small mt-2">Total manifest gross weight: @Model.cargoWeight.ToString("N2") Metric Tons</div>
                    </div>
                </div>
            </div>

            <!-- Authority Signatures -->
            <div class="col-12 mt-4 text-center">
                <div class="border p-3 d-inline-block text-start" style="min-width: 300px;">
                    <div class="small fw-bold border-bottom pb-1">Ocean Carrier Manifest Verification</div>
                    <div class="text-muted small mt-5 pt-3 border-top text-center">Authorized Signature & Seal Placeholders</div>
                </div>
            </div>

        </div>
    </div>

</body>
</html>
