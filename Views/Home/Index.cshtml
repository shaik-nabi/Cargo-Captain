@{
    Layout = "_LandingLayout";
    ViewData["Title"] = "Welcome";
}

<!-- Hero Section -->
<section class="hero-section">
    <div class="container">
        <div class="row align-items-center">
            <!-- Left Column: Content -->
            <div class="col-lg-6 mb-5 mb-lg-0">
                <div class="d-inline-flex mb-3">
                    <span class="hero-tag">
                        <i class="fas fa-globe-americas"></i> Global Customs & Cargo Infrastructure
                    </span>
                </div>
                <h1 class="hero-title mb-4">
                    Cargo Management<br>System
                </h1>
                <p class="hero-subtitle mb-5">
                    CargoClear OS streamlines ocean freight, digitizes customs declarations, tracks container staging, and automates multi-currency invoicing. Empowering shippers and administrators on one unified, high-performance platform.
                </p>
                <div class="d-flex flex-wrap gap-3">
                    <a class="btn btn-primary-custom d-inline-flex align-items-center gap-2 px-4 py-3" href="/Account/Register">
                        <span>Get Started</span>
                        <i class="fas fa-arrow-right"></i>
                    </a>
                    <a class="btn btn-light btn-outline-custom px-4 py-3" href="#about">
                        <span>Learn More</span>
                        <i class="fas fa-chevron-down"></i>
                    </a>
                </div>
            </div>
            
            <!-- Right Column: Image and Badge -->
            <div class="col-lg-6">
                <div class="position-relative">
                    <img src="~/images/container_ship.png" class="hero-card-img" alt="Cargo Ship at Sea" />
                    <div class="position-absolute bottom-0 start-0 m-4">
