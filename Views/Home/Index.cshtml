<!-- Statistics Section (Animated Counters) -->
<section id="statistics" class="py-5">
    <div class="container py-4">
        <div class="row justify-content-center mb-5 text-center">
            <div class="col-lg-6">
                <span class="text-primary fw-bold text-uppercase small tracking-wider mb-2 d-block">Live Overview</span>
                <h2 class="section-title mb-3">Operational Statistics</h2>
                <p class="text-muted">Live counters displaying the active platform throughput parameters.</p>
            </div>
        </div>
        
        <div class="row g-4 justify-content-center text-center">
            <div class="col-md-3">
                <div class="bg-white p-4 border rounded-4 shadow-sm">
                    <div class="stat-counter-value mb-2" data-target="248">0</div>
                    <span class="text-muted small fw-semibold uppercase tracking-wide">Total Bookings</span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="bg-white p-4 border rounded-4 shadow-sm">
                    <div class="stat-counter-value mb-2" data-target="192">0</div>
                    <span class="text-muted small fw-semibold uppercase tracking-wide">Active Shipments</span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="bg-white p-4 border rounded-4 shadow-sm">
                    <div class="stat-counter-value mb-2" data-target="580">0</div>
                    <span class="text-muted small fw-semibold uppercase tracking-wide">Containers Tracked</span>
                </div>
            </div>
            <div class="col-md-3">
                <div class="bg-white p-4 border rounded-4 shadow-sm">
                    <div class="stat-counter-value mb-2" data-target="15000" data-prefix="$">0</div>
                    <span class="text-muted small fw-semibold uppercase tracking-wide">Demurrage Savings</span>
                </div>
            </div>
        </div>
    </div>
</section>

<!-- JavaScript for Animated Stats Counters -->
<script>
    document.addEventListener("DOMContentLoaded", () => {
        const counters = document.querySelectorAll('.stat-counter-value');
        
        const runCounters = () => {
            counters.forEach(counter => {
                const target = parseInt(counter.getAttribute('data-target'), 10);
                const prefix = counter.getAttribute('data-prefix') || '';
                const duration = 2000; // 2 seconds animation duration
                const frameRate = 60;
                const totalFrames = duration / (1000 / frameRate);
                let currentFrame = 0;
                
                const animateValue = () => {
                    currentFrame++;
                    const progress = currentFrame / totalFrames;
                    const currentValue = Math.floor(progress * target);
                    
                    if (currentValue >= target) {
                        counter.textContent = prefix + target.toLocaleString();
                    } else {
                        counter.textContent = prefix + currentValue.toLocaleString();
                        requestAnimationFrame(animateValue);
                    }
                };
                
                requestAnimationFrame(animateValue);
            });
        };

        // Scroll trigger validation using IntersectionObserver
        const observer = new IntersectionObserver((entries, observer) => {
            entries.forEach(entry => {
                if (entry.isIntersecting) {
                    runCounters();
                    observer.unobserve(entry.target);
                }
            });
        }, { threshold: 0.5 });

        const statsSection = document.getElementById('statistics');
        if (statsSection) {
            observer.observe(statsSection);
        } else {
            runCounters(); // fallback in case ID is not found
        }
    });
</script>
