@model CargoCaptain.ViewModels.EmployeeListViewModel
@using CargoCaptain.Enums

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Employee Management";
}

<!-- Breadcrumbs Header -->
<div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Console</a></li>
                <li class="breadcrumb-item active" aria-current="page">Employees</li>
            </ol>
        </nav>
        <h2 class="h3 mb-0 fw-bold text-dark">Manage System Employees</h2>
    </div>
    
    <a href="/Admin/CreateEmployee" class="btn btn-primary-custom d-inline-flex align-items-center gap-2">
        <i class="fas fa-plus"></i>
        <span>Add Employee</span>
    </a>
</div>

<!-- TempData Alerts -->
@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-check-circle me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

<!-- Searching & Filtering Form -->
<div class="bg-white p-3 border rounded-3 mb-4 shadow-sm">
    <form method="get" asp-controller="Admin" asp-action="Employees" class="row g-3 align-items-center">
        <!-- Search query -->
        <div class="col-md-4">
            <label class="form-label small fw-bold">Search Employees</label>
            <div class="input-group input-group-sm">
                <span class="input-group-text"><i class="fas fa-search"></i></span>
                <input type="text" name="search" class="form-control" placeholder="Search by name or email..." value="@Model.SearchQuery" />
            </div>
        </div>
        <!-- Role filter -->
        <div class="col-md-3">
            <label class="form-label small fw-bold">Filter by Role</label>
            <select name="roleFilter" class="form-select form-select-sm">
                <option value="">All Roles</option>
                <option value="@UserRole.Admin" selected="@(Model.RoleFilter == UserRole.Admin)">Admin</option>
                <option value="@UserRole.FreightForwarder" selected="@(Model.RoleFilter == UserRole.FreightForwarder)">Freight Forwarder</option>
                <option value="@UserRole.CustomsBroker" selected="@(Model.RoleFilter == UserRole.CustomsBroker)">Customs Broker</option>
                <option value="@UserRole.PortOperator" selected="@(Model.RoleFilter == UserRole.PortOperator)">Port Operator</option>
            </select>
        </div>
        <!-- Sorting -->
        <div class="col-md-3">
            <label class="form-label small fw-bold">Sort By</label>
            <select name="sortBy" class="form-select form-select-sm">
                <option value="" selected="@(string.IsNullOrEmpty(Model.SortBy))">Default</option>
                <option value="firstName" selected="@(Model.SortBy == "firstName")">First Name</option>
                <option value="lastName" selected="@(Model.SortBy == "lastName")">Last Name</option>
                <option value="email" selected="@(Model.SortBy == "email")">Email Address</option>
                <option value="role" selected="@(Model.SortBy == "role")">System Role</option>
            </select>
        </div>
        <!-- Order toggle -->
        <div class="col-md-2 d-flex align-items-end gap-2" style="height: 100%;">
            <div class="form-check form-check-inline mb-2">
                <input class="form-check-input" type="checkbox" name="isDescending" value="true" checked="@Model.IsDescending" />
                <label class="form-check-label small">Desc</label>
            </div>
            <button type="submit" class="btn btn-primary btn-sm px-3">Apply</button>
            <a href="/Admin/Employees" class="btn btn-outline-secondary btn-sm"><i class="fas fa-undo"></i></a>
        </div>
    </form>
</div>

<!-- Employees Grid -->
<div class="premium-table-card shadow-sm">
    @if (Model.Employees != null && Model.Employees.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.92rem;">
                <thead class="table-light">
                    <tr>
                        <th>Employee ID</th>
                        <th>Full Name</th>
                        <th>Email Address</th>
                        <th>Phone Number</th>
                        <th>Username</th>
                        <th>Role</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var emp in Model.Employees)
                    {
                        <tr>
                            <td class="fw-bold">EMP-@emp.employeeId</td>
                            <td>@emp.firstName @emp.lastName</td>
                            <td>@emp.email</td>
                            <td>@emp.phoneNumber</td>
                            <td>@emp.Login?.AssociatedName</td>
                            <td>
                                <span class="badge bg-light text-dark border p-2">@emp.Login?.Role</span>
                            </td>
                            <td class="text-end">
                                <div class="d-flex justify-content-end gap-2">
                                    <a href="/Admin/EditEmployee/@emp.employeeId" class="btn btn-sm btn-outline-primary" title="Edit">
                                        <i class="far fa-edit"></i>
                                    </a>
                                    
                                    <form method="post" asp-controller="Admin" asp-action="DeleteEmployee" asp-route-id="@emp.employeeId" onsubmit="return confirm('Are you sure you want to delete this employee? This will permanently delete their login details as well.');" class="d-inline">
                                        @Html.AntiForgeryToken()
                                        <button type="submit" class="btn btn-sm btn-outline-danger" title="Delete">
                                            <i class="far fa-trash-alt"></i>
                                        </button>
                                    </form>
                                </div>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
        
        <!-- Pagination controls -->
        @if (Model.TotalPages > 1)
        {
            <div class="d-flex justify-content-between align-items-center mt-4 border-top pt-3">
                <span class="small text-muted">Showing page @Model.CurrentPage of @Model.TotalPages (Total Items: @Model.TotalItems)</span>
                <nav aria-label="Page navigation">
                    <ul class="pagination pagination-sm mb-0">
                        <!-- Previous button -->
                        <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                            <a class="page-link" href="/Admin/Employees?page=@(Model.CurrentPage - 1)&search=@Model.SearchQuery&roleFilter=@Model.RoleFilter&sortBy=@Model.SortBy&isDescending=@Model.IsDescending">Previous</a>
                        </li>
                        
                        <!-- Page indices -->
                        @for (int p = 1; p <= Model.TotalPages; p++)
                        {
                            <li class="page-item @(p == Model.CurrentPage ? "active" : "")">
                                <a class="page-link" href="/Admin/Employees?page=@p&search=@Model.SearchQuery&roleFilter=@Model.RoleFilter&sortBy=@Model.SortBy&isDescending=@Model.IsDescending">@p</a>
                            </li>
                        }

                        <!-- Next button -->
                        <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                            <a class="page-link" href="/Admin/Employees?page=@(Model.CurrentPage + 1)&search=@Model.SearchQuery&roleFilter=@Model.RoleFilter&sortBy=@Model.SortBy&isDescending=@Model.IsDescending">Next</a>
                        </li>
                    </ul>
                </nav>
            </div>
        }
    }
    else
    {
        <div class="text-center py-5 text-muted">
            <i class="fas fa-users fa-3x mb-3 text-opacity-25"></i>
            <h4>No Employees Found</h4>
            <p class="small text-muted mb-0">Try clearing filters or add a new employee profile to begin.</p>
        </div>
    }
</div>
