@model CargoCaptain.ViewModels.AdminDashboardViewModel

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Dashboard";
}

<!-- Breadcrumbs Header -->
<div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Console</a></li>
                <li class="breadcrumb-item active" aria-current="page">Dashboard</li>
            </ol>
        </nav>
        <h2 class="h3 mb-0 fw-bold text-dark">Console Dashboard Overview</h2>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-4 mb-4">
    <!-- Card 1: Total Revenue -->
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card">
            <div>
                <span class="metric-title">Total Revenue</span>
                <h3 class="metric-value mb-0 mt-1">$@Model.TotalRevenue.ToString("N2")</h3>
            </div>
            <div class="metric-icon-box bg-success bg-opacity-10 text-success">
                <i class="fas fa-hand-holding-usd fa-lg"></i>
            </div>
        </div>
    </div>
    <!-- Card 2: Total Profit -->
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card">
            <div>
                <span class="metric-title">Total Profit</span>
                <h3 class="metric-value mb-0 mt-1">$@Model.TotalProfit.ToString("N2")</h3>
            </div>
            <div class="metric-icon-box bg-primary bg-opacity-10 text-primary">
                <i class="fas fa-chart-line fa-lg"></i>
            </div>
        </div>
    </div>
    <!-- Card 3: Total Bookings -->
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card">
            <div>
                <span class="metric-title">Total Bookings</span>
                <h3 class="metric-value mb-0 mt-1">@Model.TotalBookings</h3>
            </div>
            <div class="metric-icon-box bg-info bg-opacity-10 text-info">
                <i class="fas fa-file-contract fa-lg"></i>
            </div>
        </div>
    </div>
    <!-- Card 4: Total Containers -->
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card">
            <div>
                <span class="metric-title">Total Containers</span>
                <h3 class="metric-value mb-0 mt-1">@Model.TotalContainers</h3>
            </div>
            <div class="metric-icon-box bg-warning bg-opacity-10 text-warning">
                <i class="fas fa-cubes fa-lg"></i>
            </div>
        </div>
    </div>
</div>

<!-- Graph Visualizations -->
<div class="row g-4 mb-4">
    <!-- Revenue Bar Chart -->
    <div class="col-lg-6">
        <div class="bg-white p-4 border rounded-3 shadow-sm">
            <h5 class="fw-bold text-dark mb-3"><i class="fas fa-chart-bar text-primary me-2"></i>Revenue Metrics</h5>
            <div style="position: relative; height:300px; width:100%">
                <canvas id="revenueChart"></canvas>
            </div>
        </div>
    </div>
    <!-- Profits Line Chart -->
    <div class="col-lg-6">
        <div class="bg-white p-4 border rounded-3 shadow-sm">
            <h5 class="fw-bold text-dark mb-3"><i class="fas fa-chart-line text-primary me-2"></i>Profit Progression</h5>
            <div style="position: relative; height:300px; width:100%">
                <canvas id="profitChart"></canvas>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Recent Bookings Table -->
    <div class="col-lg-6">
        <div class="premium-table-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0"><i class="fas fa-ship text-primary me-2"></i>Recent Shipment Bookings</h5>
                <a href="#" class="btn btn-manage btn-sm">See All</a>
            </div>
            
            @if (Model.RecentBookings != null && Model.RecentBookings.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.9rem;">
                        <thead class="table-light">
                            <tr>
                                <th>Booking Ref</th>
                                <th>Shipper</th>
                                <th>Route</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var booking in Model.RecentBookings)
                            {
                                <tr>
                                    <td class="fw-bold text-primary">@booking.bookingNumber</td>
                                    <td>@booking.shipperName</td>
                                    <td style="font-size: 0.8rem;">
                                        <div><strong>From:</strong> @booking.originPort</div>
                                        <div><strong>To:</strong> @booking.destinationPort</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-opacity-10 text-primary bg-primary p-2">@booking.bookingStatus</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-folder-open fa-2x mb-2 text-opacity-50"></i>
                    <div>No Recent Bookings</div>
                </div>
            }
        </div>
    </div>

    <!-- Recent Invoices Table -->
    <div class="col-lg-6">
        <div class="premium-table-card">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0"><i class="fas fa-file-invoice-dollar text-primary me-2"></i>Recent Invoices</h5>
                <a href="#" class="btn btn-manage btn-sm">See All</a>
            </div>
            
            @if (Model.RecentInvoices != null && Model.RecentInvoices.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.9rem;">
                        <thead class="table-light">
                            <tr>
                                <th>Invoice ID</th>
                                <th>Booking Ref</th>
                                <th>Total Amount</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var invoice in Model.RecentInvoices)
                            {
                                <tr>
                                    <td class="fw-bold text-dark">INV-@invoice.invoiceId</td>
                                    <td>@invoice.ShipmentBooking?.bookingNumber</td>
                                    <td class="fw-bold">@invoice.currency @invoice.totalAmount.ToString("N2")</td>
                                    <td>
                                        <span class="badge bg-opacity-10 text-success bg-success p-2">@invoice.invoiceStatus</span>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-receipt fa-2x mb-2 text-opacity-50"></i>
                    <div>No Recent Invoices</div>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
    <!-- Chart.js Library CDN -->
    <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
    <script>
        document.addEventListener("DOMContentLoaded", () => {
            // Retrieve dynamic arrays from C# model
            const months = @Json.Serialize(Model.ChartMonths);
            const revenues = @Json.Serialize(Model.ChartRevenueData);
            const profits = @Json.Serialize(Model.ChartProfitData);

            // 1. Revenue Chart
            const ctxRev = document.getElementById('revenueChart').getContext('2d');
            new Chart(ctxRev, {
                type: 'bar',
                data: {
                    labels: months,
                    datasets: [{
                        label: 'Total Revenue ($)',
                        data: revenues,
                        backgroundColor: 'rgba(37, 99, 235, 0.75)',
                        borderColor: '#2563eb',
                        borderWidth: 1,
                        borderRadius: 6
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: '#f1f5f9' }
                        },
                        x: {
                            grid: { display: false }
                        }
                    }
                }
            });

            // 2. Profit Chart
            const ctxProf = document.getElementById('profitChart').getContext('2d');
            new Chart(ctxProf, {
                type: 'line',
                data: {
                    labels: months,
                    datasets: [{
                        label: 'Total Profits ($)',
                        data: profits,
                        backgroundColor: 'rgba(74, 222, 128, 0.1)',
                        borderColor: '#4ade80',
                        borderWidth: 2,
                        fill: true,
                        tension: 0.3,
                        pointRadius: 4
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: false,
                    scales: {
                        y: {
                            beginAtZero: true,
                            grid: { color: '#f1f5f9' }
                        },
                        x: {
                            grid: { display: false }
                        }
                    }
                }
            });
        });
    </script>
}
