@model CargoCaptain.ViewModels.LoginViewModel

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Login";
}

<h4 class="fw-bold text-center text-dark mb-4">Sign In</h4>

<form method="post" asp-controller="Account" asp-action="Login">
    @Html.AntiForgeryToken()
    
    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

    <div class="mb-3">
        <label asp-for="Username" class="form-label small fw-semibold"></label>
        <div class="input-group">
            <span class="input-group-text bg-light border-end-0"><i class="far fa-user text-muted"></i></span>
            <input asp-for="Username" class="form-control bg-light border-start-0 ps-0" placeholder="System Admin" required />
        </div>
        <span asp-validation-for="Username" class="text-danger small"></span>
    </div>
    
    <div class="mb-3">
        <div class="d-flex justify-content-between align-items-center mb-1">
            <label asp-for="Password" class="form-label small fw-semibold mb-0"></label>
            <a href="#" class="small text-decoration-none" style="font-size: 0.8rem;">Forgot Password?</a>
        </div>
        <div class="input-group">
            <span class="input-group-text bg-light border-end-0"><i class="fas fa-lock text-muted"></i></span>
            <input asp-for="Password" class="form-control bg-light border-start-0 border-end-0 ps-0" placeholder="••••••••" required />
            <button class="btn btn-light border border-start-0 text-muted toggle-password" type="button" tabindex="-1">
                <i class="far fa-eye"></i>
            </button>
        </div>
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>
    
    <button type="submit" class="btn btn-primary-custom w-100 py-2.5 d-flex align-items-center justify-content-center gap-2 mb-3">
        <span>Sign In</span>
        <i class="fas fa-sign-in-alt"></i>
    </button>
</form>

<div class="text-center small mt-3">
    <span class="text-muted">New to CargoCaptain?</span>
    <a href="/Account/Register" class="text-decoration-none fw-semibold ms-1">Create an account</a>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
