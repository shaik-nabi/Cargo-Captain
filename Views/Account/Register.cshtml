@model CargoCaptain.ViewModels.RegisterViewModel
@using CargoCaptain.Enums

@{
    Layout = "_AuthLayout";
    ViewData["Title"] = "Register";
}

<h4 class="fw-bold text-center text-dark mb-4">Create Account</h4>

<form method="post" asp-controller="Account" asp-action="Register">
    @Html.AntiForgeryToken()

    <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

    <div class="mb-3">
        <label asp-for="FullName" class="form-label small fw-semibold"></label>
        <div class="input-group">
            <span class="input-group-text bg-light border-end-0"><i class="far fa-id-card text-muted"></i></span>
            <input asp-for="FullName" class="form-control bg-light border-start-0 ps-0" placeholder="John Doe" required />
        </div>
        <span asp-validation-for="FullName" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Email" class="form-label small fw-semibold"></label>
        <div class="input-group">
            <span class="input-group-text bg-light border-end-0"><i class="far fa-envelope text-muted"></i></span>
            <input asp-for="Email" class="form-control bg-light border-start-0 ps-0" placeholder="john@example.com" required />
        </div>
        <span asp-validation-for="Email" class="text-danger small"></span>
    </div>

    <div class="mb-3">
        <label asp-for="Role" class="form-label small fw-semibold"></label>
        <div class="input-group">
            <span class="input-group-text bg-light border-end-0"><i class="fas fa-briefcase text-muted"></i></span>
            <select asp-for="Role" class="form-select bg-light border-start-0 ps-0" required>
                <option value="" disabled selected>Select your registration role...</option>
                <option value="@UserRole.Shipper">Shipper (Consignor Client)</option>
                <option value="@UserRole.Consignee">Consignee (Recipient Client)</option>
            </select>
        </div>
        <span asp-validation-for="Role" class="text-danger small"></span>
    </div>
    
    <div class="mb-3">
        <label asp-for="Password" class="form-label small fw-semibold"></label>
        <div class="input-group">
            <span class="input-group-text bg-light border-end-0"><i class="fas fa-lock text-muted"></i></span>
            <input asp-for="Password" class="form-control bg-light border-start-0 border-end-0 ps-0" placeholder="••••••••" required />
            <button class="btn btn-light border border-start-0 text-muted toggle-password" type="button" tabindex="-1">
                <i class="far fa-eye"></i>
            </button>
        </div>
        <span asp-validation-for="Password" class="text-danger small"></span>
    </div>

    <div class="mb-4">
        <label asp-for="ConfirmPassword" class="form-label small fw-semibold"></label>
        <div class="input-group">
            <span class="input-group-text bg-light border-end-0"><i class="fas fa-shield-alt text-muted"></i></span>
            <input asp-for="ConfirmPassword" class="form-control bg-light border-start-0 border-end-0 ps-0" placeholder="••••••••" required />
            <button class="btn btn-light border border-start-0 text-muted toggle-password" type="button" tabindex="-1">
                <i class="far fa-eye"></i>
            </button>
        </div>
        <span asp-validation-for="ConfirmPassword" class="text-danger small"></span>
    </div>
    
    <button type="submit" class="btn btn-primary-custom w-100 py-2.5 d-flex align-items-center justify-content-center gap-2 mb-3">
        <span>Register Account</span>
        <i class="fas fa-user-plus"></i>
    </button>
</form>

<div class="text-center small mt-3">
    <span class="text-muted">Already have an account?</span>
    <a href="/Account/Login" class="text-decoration-none fw-semibold ms-1">Sign in here</a>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
