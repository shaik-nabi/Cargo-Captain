@model IEnumerable<CargoCaptain.Models.ShipmentBooking>

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Eligible Cargo Bookings";
}

<!-- Breadcrumbs Header -->
<div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Console</a></li>
                <li class="breadcrumb-item"><a href="/Customs" class="text-decoration-none">Customs Console</a></li>
                <li class="breadcrumb-item active" aria-current="page">Eligible Bookings</li>
            </ol>
        </nav>
        <h2 class="h3 mb-0 fw-bold text-dark">File Customs Clearance</h2>
    </div>
</div>

<!-- TempData Alerts -->
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show shadow-sm" role="alert">
        <i class="fas fa-exclamation-triangle me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
    </div>
}

@{
    var docsMap = ViewBag.DocumentsMap as Dictionary<int, List<CargoCaptain.Controllers.DocumentMetadata>> 
        ?? new Dictionary<int, List<CargoCaptain.Controllers.DocumentMetadata>>();
}

<div class="premium-table-card shadow-sm">
    <h5 class="fw-bold text-dark mb-3"><i class="fas fa-ship text-primary me-2"></i>Cargo Bookings & Customs Filing</h5>
    <p class="text-muted small">Select an eligible cargo booking to review documents and file a customs declaration:</p>

    @if (Model != null && Model.Any())
    {
        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0" style="font-size: 0.9rem;">
                <thead class="table-light">
                    <tr>
                        <th>Booking Number</th>
                        <th>Shipper</th>
                        <th>Consignee</th>
                        <th>Route Details</th>
                        <th>Containers</th>
                        <th>Customs Documents</th>
                        <th class="text-end">Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var b in Model)
                    {
                        var docList = docsMap.ContainsKey(b.bookingId) ? docsMap[b.bookingId] : new List<CargoCaptain.Controllers.DocumentMetadata>();
                        bool hasDocs = docList.Any();

                        <tr>
                            <td class="fw-bold text-primary">@b.bookingNumber</td>
                            <td>@b.shipperName</td>
                            <td>@b.consigneeName</td>
                            <td style="font-size: 0.8rem;">
                                <div><strong>From:</strong> @b.originPort</div>
                                <div><strong>To:</strong> @b.destinationPort</div>
                            </td>
                            <td>
                                @if (b.Containers.Any())
                                {
                                    <span class="badge bg-success bg-opacity-10 text-success p-2">@b.Containers.Count Containers</span>
                                }
                                else
                                {
                                    <span class="badge bg-secondary bg-opacity-10 text-secondary p-2">0 Containers</span>
                                }
                            </td>
                            <td>
                                @if (hasDocs)
                                {
                                    <div class="d-flex flex-column gap-1">
                                        @foreach (var doc in docList)
                                        {
                                            <a href="/uploads/bookings/@b.bookingId/@doc.GuidName" target="_blank" class="text-decoration-none small text-dark d-inline-flex align-items-center gap-1" download="@doc.OriginalName" title="Download @doc.OriginalName">
                                                <i class="far fa-file-pdf text-danger"></i>
                                                <span class="text-truncate" style="max-width: 150px;">@doc.OriginalName</span>
                                                <i class="fas fa-download text-muted ms-1" style="font-size: 0.75rem;"></i>
                                            </a>
                                        }
                                    </div>
                                }
                                else
                                {
                                    <span class="badge bg-warning bg-opacity-10 text-warning p-2"><i class="far fa-file me-1"></i> No Documents</span>
                                }
                            </td>
                            <td class="text-end">
                                @if (b.CustomsDeclaration == null)
                                {
                                    if (hasDocs)
                                    {
                                        <a href="/Customs/File?bookingId=@b.bookingId" class="btn btn-primary-custom btn-sm">
                                            <i class="fas fa-file-invoice me-1"></i> File Export
                                        </a>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning bg-opacity-10 text-warning p-2"><i class="fas fa-file-upload me-1"></i> Pending Documents</span>
                                    }
                                }
                                else if (b.CustomsDeclaration.declarationType == CargoCaptain.Enums.DeclarationType.EXPORT)
                                {
                                    if (b.CustomsDeclaration.clearanceStatus == CargoCaptain.Enums.ClearanceStatus.CLEARED)
                                    {
                                        bool discharged = b.Containers.Any(c => c.CargoEvents != null && c.CargoEvents.Any(e => e.eventType == CargoCaptain.Enums.CargoEventType.DISCHARGED));
                                        if (discharged)
                                        {
                                            <form method="post" asp-controller="Customs" asp-action="TransitionToImport" asp-route-bookingId="@b.bookingId" class="d-inline">
                                                @Html.AntiForgeryToken()
                                                <button type="submit" class="btn btn-success btn-sm"><i class="fas fa-file-import me-1"></i> File Import</button>
                                            </form>
                                        }
                                        else
                                        {
                                            <span class="badge bg-info bg-opacity-10 text-info p-2"><i class="fas fa-ship me-1"></i> Export Cleared</span>
                                        }
                                    }
                                    else
                                    {
                                        <a href="/Customs/Details?id=@b.CustomsDeclaration.declarationId" class="btn btn-outline-primary btn-sm">
                                            Export: @b.CustomsDeclaration.clearanceStatus
                                        </a>
                                    }
                                }
                                else // IMPORT
                                {
                                    <a href="/Customs/Details?id=@b.CustomsDeclaration.declarationId" class="btn btn-outline-success btn-sm">
                                        Import: @b.CustomsDeclaration.clearanceStatus
                                    </a>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
    else
    {
        <div class="text-center py-5 text-muted">
            <i class="fas fa-shipping-fast fa-3x mb-3 text-opacity-25 text-primary"></i>
            <h4>No Cargo Bookings Found</h4>
            <p class="small text-muted mb-0">Active bookings created by shippers will appear here for customs clearance.</p>
        </div>
    }
</div>
