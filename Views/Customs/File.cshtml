@model CargoCaptain.ViewModels.FileDeclarationViewModel
@using CargoCaptain.Enums

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "File Customs Declaration";
}

@{
    var uploadedDocs = ViewBag.UploadedDocuments as List<CargoCaptain.Controllers.DocumentMetadata> ?? new List<CargoCaptain.Controllers.DocumentMetadata>();
}

<!-- Breadcrumbs Header -->
<div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Console</a></li>
                <li class="breadcrumb-item"><a href="/Customs" class="text-decoration-none">Customs Console</a></li>
                <li class="breadcrumb-item active" aria-current="page">File</li>
            </ol>
        </nav>
        <h2 class="h3 mb-0 fw-bold text-dark">Submit Customs Declaration: @Model.bookingNumber</h2>
    </div>
</div>

<div class="row g-4">
    <!-- Form Side -->
    <div class="col-lg-7">
        <div class="bg-white p-4 border rounded-3 shadow-sm mb-4">
            <form method="post" asp-controller="Customs" asp-action="File">
                @Html.AntiForgeryToken()
                <input type="hidden" asp-for="bookingId" />
                
                <div asp-validation-summary="ModelOnly" class="text-danger small mb-3"></div>

                <div class="mb-3">
                    <label asp-for="declarationType" class="form-label small fw-bold"></label>
                    <select asp-for="declarationType" class="form-select form-select-sm" required>
                        <option value="@DeclarationType.EXPORT">Export Customs Clearance</option>
                        <option value="@DeclarationType.IMPORT">Import Customs Clearance</option>
                    </select>
                    <span asp-validation-for="declarationType" class="text-danger small"></span>
                </div>

                <div class="mb-3">
                    <label asp-for="hsCode" class="form-label small fw-bold"></label>
                    <input asp-for="hsCode" class="form-control form-control-sm" placeholder="e.g. 847130 (Min 6, Max 10 digits)" required />
                    <span asp-validation-for="hsCode" class="text-danger small"></span>
                    <div class="form-text small text-muted">First 2 digits map the global tariff rate category.</div>
                </div>

                <div class="mb-4">
                    <label asp-for="declaredValue" class="form-label small fw-bold"></label>
                    <div class="input-group input-group-sm">
                        <span class="input-group-text">$</span>
                        <input asp-for="declaredValue" type="number" step="0.01" class="form-control" placeholder="Declared commercial cargo value in USD" required />
                    </div>
                    <span asp-validation-for="declaredValue" class="text-danger small"></span>
                </div>

                <div class="d-flex gap-2 justify-content-end">
                    <a href="/Customs/Bookings" class="btn btn-outline-secondary btn-sm">Cancel</a>
                    <button type="submit" class="btn btn-primary-custom btn-sm">File Customs Ledger</button>
                </div>
            </form>
        </div>
    </div>

    <!-- Info/Rates Side -->
    <div class="col-lg-5">
        <!-- Uploaded Documents Inspection Box -->
        <div class="bg-white p-4 border rounded-3 shadow-sm mb-4">
            <h5 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="fas fa-file-check text-primary me-2"></i>Uploaded Supporting Documents</h5>
            @if (uploadedDocs.Any())
            {
                <div class="list-group list-group-flush small">
                    @foreach (var doc in uploadedDocs)
                    {
                        <div class="list-group-item px-0 py-2 d-flex justify-content-between align-items-center">
                            <span class="text-truncate" style="max-width: 220px;"><i class="far fa-file-pdf text-danger me-2"></i>@doc.OriginalName</span>
                            <a href="/uploads/bookings/@Model.bookingId/@doc.GuidName" target="_blank" class="btn btn-sm btn-light border px-2" download="@doc.OriginalName">
                                <i class="fas fa-download me-1"></i> View
                            </a>
                        </div>
                    }
                </div>
            }
            else
            {
                <p class="text-muted small mb-0">No documents uploaded.</p>
            }
        </div>

        <div class="bg-white p-4 border rounded-3 shadow-sm">
            <h5 class="fw-bold text-dark border-bottom pb-2 mb-3"><i class="fas fa-calculator text-primary me-2"></i>Global Tariff Rates</h5>
            <p class="text-muted small">Import duty is calculated dynamically on filing based on the first two digits of the HS code:</p>
            
            <ul class="list-group list-group-flush mb-0 small">
                <li class="list-group-item px-0 d-flex justify-content-between">
                    <span><i class="fas fa-laptop text-muted me-2"></i>Electronics (prefix 84, 85)</span>
                    <span class="fw-bold text-dark">5% rate</span>
                </li>
                <li class="list-group-item px-0 d-flex justify-content-between">
                    <span><i class="fas fa-tshirt text-muted me-2"></i>Textiles (prefix 50 to 63)</span>
                    <span class="fw-bold text-dark">10% rate</span>
                </li>
                <li class="list-group-item px-0 d-flex justify-content-between">
                    <span><i class="fas fa-flask text-muted me-2"></i>Chemicals (prefix 28 to 38)</span>
                    <span class="fw-bold text-dark">8% rate</span>
                </li>
                <li class="list-group-item px-0 d-flex justify-content-between">
                    <span><i class="fas fa-car text-muted me-2"></i>Automotive (prefix 87)</span>
                    <span class="fw-bold text-dark">12% rate</span>
                </li>
                <li class="list-group-item px-0 d-flex justify-content-between">
                    <span><i class="fas fa-box text-muted me-2"></i>General / Other prefixes</span>
                    <span class="fw-bold text-dark">6% rate</span>
                </li>
            </ul>
        </div>
    </div>
</div>

@section Scripts {
    @await Html.PartialAsync("_ValidationScriptsPartial")
}
