@model CargoCaptain.ViewModels.CustomsDashboardViewModel
@using CargoCaptain.Enums

@{
    Layout = "_DashboardLayout";
    ViewData["Title"] = "Customs Dashboard";
}

<!-- Breadcrumbs Header -->
<div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-2">
    <div>
        <nav aria-label="breadcrumb">
            <ol class="breadcrumb mb-1">
                <li class="breadcrumb-item"><a href="/" class="text-decoration-none">Console</a></li>
                <li class="breadcrumb-item active" aria-current="page">Customs Dashboard</li>
            </ol>
        </nav>
        <h2 class="h3 mb-0 fw-bold text-dark">Customs Broker Console</h2>
    </div>
</div>

<!-- KPI Cards -->
<div class="row g-4 mb-4">
    <!-- Card 1: Total Submissions -->
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card">
            <div>
                <span class="metric-title">Total Cargo Submissions</span>
                <h3 class="metric-value mb-0 mt-1">@Model.TotalSubmissions</h3>
            </div>
            <div class="metric-icon-box bg-primary bg-opacity-10 text-primary">
                <i class="fas fa-shield-alt fa-lg"></i>
            </div>
        </div>
    </div>
    <!-- Card 2: Pending Action -->
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card">
            <div>
                <span class="metric-title">Pending Action</span>
                <h3 class="metric-value mb-0 mt-1">@Model.PendingActionCount</h3>
            </div>
            <div class="metric-icon-box bg-warning bg-opacity-10 text-warning">
                <i class="far fa-hourglass fa-lg"></i>
            </div>
        </div>
    </div>
    <!-- Card 3: Approved/Cleared -->
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card">
            <div>
                <span class="metric-title">Approved Clearance</span>
                <h3 class="metric-value mb-0 mt-1">@Model.ApprovedCount</h3>
            </div>
            <div class="metric-icon-box bg-success bg-opacity-10 text-success">
                <i class="fas fa-check-circle fa-lg"></i>
            </div>
        </div>
    </div>
    <!-- Card 4: Held/Rejected -->
    <div class="col-sm-6 col-xl-3">
        <div class="metric-card">
            <div>
                <span class="metric-title">Held / Rejected</span>
                <h3 class="metric-value mb-0 mt-1">@Model.HeldCount</h3>
            </div>
            <div class="metric-icon-box bg-danger bg-opacity-10 text-danger">
                <i class="fas fa-exclamation-triangle fa-lg"></i>
            </div>
        </div>
    </div>
</div>

<div class="row g-4">
    <!-- Recent Submissions Table -->
    <div class="col-lg-12">
        <div class="premium-table-card shadow-sm">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h5 class="fw-bold text-dark mb-0"><i class="fas fa-list text-primary me-2"></i>Recent Customs Submissions</h5>
                <a href="/Customs/Declarations" class="btn btn-manage btn-sm">All Declarations & Log</a>
            </div>
            
            @if (Model.RecentEntries != null && Model.RecentEntries.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0" style="font-size: 0.9rem;">
                        <thead class="table-light">
                            <tr>
                                <th>Ref ID</th>
                                <th>Booking Number</th>
                                <th>Shipper</th>
                                <th>Customs Documents</th>
                                <th>Classification / Duty</th>
                                <th>Status</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in Model.RecentEntries)
                            {
                                <tr>
                                    <td class="fw-bold text-dark">
                                        @if (entry.IsFiledDeclaration)
                                        {
                                            <span class="text-primary">DEC-@entry.DeclarationId</span>
                                        }
                                        else
                                        {
                                            <span>@entry.BookingNumber</span>
                                        }
                                    </td>
                                    <td class="text-primary fw-semibold">@entry.BookingNumber</td>
                                    <td>@entry.ShipperName</td>
                                    <td>
                                        @if (entry.Documents.Any())
                                        {
                                            <div class="d-flex flex-column gap-1">
                                                @foreach (var doc in entry.Documents)
                                                {
                                                    <a href="/uploads/bookings/@entry.BookingId/@doc.GuidName" target="_blank" class="text-decoration-none small text-dark d-inline-flex align-items-center gap-1" download="@doc.OriginalName">
                                                        <i class="far fa-file-pdf text-danger"></i>
                                                        <span class="text-truncate" style="max-width: 140px;">@doc.OriginalName</span>
                                                    </a>
                                                }
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="badge bg-warning bg-opacity-10 text-warning p-2"><i class="far fa-file me-1"></i> No Documents</span>
                                        }
                                    </td>
                                    <td>
                                        @if (entry.IsFiledDeclaration)
                                        {
                                            <div><code>@entry.HsCode</code></div>
                                            <div class="small fw-bold text-primary">$@entry.CalculatedDuty.ToString("N2") Duty</div>
                                        }
                                        else
                                        {
                                            <span class="text-muted small">@entry.ContainerCount Container(s)</span>
                                        }
                                    </td>
                                    <td>
                                        @if (entry.IsFiledDeclaration)
                                        {
                                            if (entry.ClearanceStatus == ClearanceStatus.FILED)
                                            {
                                                <span class="badge bg-warning bg-opacity-10 text-warning p-2">PENDING REVIEW</span>
                                            }
                                            else if (entry.ClearanceStatus == ClearanceStatus.UNDER_REVIEW)
                                            {
                                                <span class="badge bg-info bg-opacity-10 text-info p-2">UNDER REVIEW</span>
                                            }
                                            else if (entry.ClearanceStatus == ClearanceStatus.CLEARED)
                                            {
                                                <span class="badge bg-success bg-opacity-10 text-success p-2">APPROVED</span>
                                            }
                                            else if (entry.ClearanceStatus == ClearanceStatus.HELD)
                                            {
                                                <span class="badge bg-secondary bg-opacity-10 text-secondary p-2">HELD</span>
                                            }
                                            else if (entry.ClearanceStatus == ClearanceStatus.REJECTED)
                                            {
                                                <span class="badge bg-danger bg-opacity-10 text-danger p-2">REJECTED</span>
                                            }
                                        }
                                        else
                                        {
                                            if (entry.Documents.Any())
                                            {
                                                <span class="badge bg-primary bg-opacity-10 text-primary p-2">READY FOR FILING</span>
                                            }
                                            else
                                            {
                                                <span class="badge bg-warning bg-opacity-10 text-warning p-2">PENDING DOCS</span>
                                            }
                                        }
                                    </td>
                                    <td class="text-end">
                                        @if (entry.IsFiledDeclaration)
                                        {
                                            <a href="/Customs/Details/@entry.DeclarationId" class="btn btn-manage btn-sm">Review File</a>
                                        }
                                        else
                                        {
                                            if (entry.Documents.Any())
                                            {
                                                <a href="/Customs/File?bookingId=@entry.BookingId" class="btn btn-primary-custom btn-sm">File Export</a>
                                            }
                                            else
                                            {
                                                <a href="/Customs/Bookings" class="btn btn-outline-secondary btn-sm">View Status</a>
                                            }
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="text-center py-5 text-muted">
                    <i class="fas fa-shield-alt fa-3x mb-3 text-opacity-25 text-primary"></i>
                    <h5 class="fw-bold text-dark">No Customs Submissions Found</h5>
                    <p class="small text-muted mb-0">Active bookings and customs declarations will be listed here.</p>
                </div>
            }
        </div>
    </div>
</div>
